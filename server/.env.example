# Postgres connection string.
# Local dev: postgresql://<user>@localhost:5432/ts_one?schema=public
# Production (Neon): copy the "pooled" connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Local dev only. Not needed in the single Vercel deployment (API is same-origin).
API_PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
